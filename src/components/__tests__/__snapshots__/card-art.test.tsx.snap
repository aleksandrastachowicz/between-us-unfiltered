exports[`card backs > friendship snapshot is stable 1`] = `"<div class="relative h-full w-full overflow-hidden" style="background:#E8A200"><svg viewBox="0 0 300 420" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><filter id="liq-friendship" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.008 0.014" numOctaves="2" seed="7" result="n"></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="26" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap></filter><filter id="grain-friendship" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch" result="g"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter><radialGradient id="wash-friendship" cx="50%" cy="36%" r="72%"><stop offset="0%" stop-color="#FFD429" stop-opacity="0.85"></stop><stop offset="100%" stop-color="#FFD429" stop-opacity="0"></stop></radialGradient><pattern id="chk-friendship" width="48" height="48" patternUnits="userSpaceOnUse"><rect width="48" height="48" fill="#E8A200"></rect><rect width="24" height="24" fill="#FFCF7A" fill-opacity="0.9"></rect><rect x="24" y="24" width="24" height="24" fill="#FFCF7A" fill-opacity="0.9"></rect></pattern><pattern id="daisy-friendship" width="60" height="60" patternUnits="userSpaceOnUse"><rect width="60" height="60" fill="#E8A200"></rect><g transform="translate(30 30)" fill="#FFCF7A"><ellipse rx="5.5" ry="12" transform="rotate(0) translate(0 -12)"></ellipse><ellipse rx="5.5" ry="12" transform="rotate(45) translate(0 -12)"></ellipse><ellipse rx="5.5" ry="12" transform="rotate(90) translate(0 -12)"></ellipse><ellipse rx="5.5" ry="12" transform="rotate(135) translate(0 -12)"></ellipse><ellipse rx="5.5" ry="12" transform="rotate(180) translate(0 -12)"></ellipse><ellipse rx="5.5" ry="12" transform="rotate(225) translate(0 -12)"></ellipse><ellipse rx="5.5" ry